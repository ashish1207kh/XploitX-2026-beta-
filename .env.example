# ==============================================================================
# XploitX 2.0 Beta — Environment Configuration Example (.env.example)
# DO NOT store production passwords or actual secret keys in this file.
# Copy this file to .env and provide your deployment-specific credentials.
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://xploitx-backend.onrender.com
FRONTEND_URL=https://xploitxctf.me

# Database Configuration (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/xploitx?retryWrites=true&w=majority

# JWT Authentication Secret (REQUIRED in production: min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# High Command Administrator Credentials
ADMIN_PASS_ADMINISTRATOR=StrongAdminPasswordHere123!
ADMIN_PASS_JESIN=JesinSecretPasswordHere456!
ADMIN_PASS_ASHISH=AshishSecretPasswordHere789!
ADMIN_PASS_MADHU=MadhuSecretPasswordHere321!

# Field Operations & Attendance Verification Security Key
ATTENDANCE_SECURITY_KEY=StrongAttendanceDeskKey2026!

# Email Delivery Providers (Configure at least one provider)
# Provider 1: Brevo (Recommended HTTPS REST API)
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=xploitxbeta2.0@gmail.com
BREVO_SENDER_NAME=XploitX 2.0 BETA

# Provider 2: Resend (Optional Alternative)
RESEND_API_KEY=re_your_resend_api_key_here

# Provider 3: SendGrid (Optional Alternative)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Provider 4: SMTP Relay / Nodemailer (Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=xploitxbeta2.0@gmail.com
SMTP_PASS=your-google-app-password-no-spaces
EMAIL_USER=xploitxbeta2.0@gmail.com
EMAIL_PASS=your-google-app-password-no-spaces
EMAIL_FROM="XploitX 2.0 Beta <xploitxbeta2.0@gmail.com>"

# Optional External Management API Key
API_KEY=optional_external_service_api_key

# Destructive Guard (SAFETY LOCK: Only set to 'CONFIRMED_AND_APPROVED' during authorized maintenance)
ALLOW_DESTRUCTIVE_PRODUCTION_OPERATIONS=LOCKED
