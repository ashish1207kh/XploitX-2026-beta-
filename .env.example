# XPLOITX 2.0 BETA ENVIRONMENT CONFIGURATION
PORT=3000
NODE_ENV=production

# Database Connection (MongoDB Atlas Persistent Cloud Storage)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@your-cluster-url.mongodb.net/?appName=Cluster0

# Authentication & JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Email Infrastructure (Brevo API Primary, Resend / SendGrid / SMTP Fallbacks)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@domain.com
BREVO_SENDER_NAME=XploitX 2.0 BETA

# Optional Fallbacks
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Production Change Protection Gate (Do NOT set to CONFIRMED_AND_APPROVED unless executing an approved, backed-up migration)
ALLOW_DESTRUCTIVE_PRODUCTION_OPERATIONS=NONE
